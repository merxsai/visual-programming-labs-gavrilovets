        "name": "function 2",
        "func": "const id = msg.req.query.id;\n\nif (!id) {\n    msg.statusCode = 400;\n    msg.payload = { \n        status: 400, \n        error: \"Не передан обязательный параметр запроса: ?id=\" \n    };\n} else if (id === \"1\") {\n    msg.statusCode = 200;\n    msg.payload = { \n        id: 1, \n        name: \"Контроллер сбора данных ESP32\", \n        owner: \"Гавриловец\",\n        available: true \n    };\n} else {\n    msg.statusCode = 404;\n    msg.payload = { \n        status: 404, \n        error: `Элемент с id=${id} не найден в реестре` \n    };\n}\n\nreturn msg;",
