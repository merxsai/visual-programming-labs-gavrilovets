    {
        "id": "9583a2f38b28eb20",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "function 4",
        "func": "const text = msg.payload.content || \"\";\nconst chatId = msg.payload.chatId;\n\nlet replyText = \"\";\n\n// 1. Команда /start\nif (text === \"/start\") {\n    replyText = \"Привет! Я бот студента Гавриловца Ильи по лабораторной работе №2.\";\n}\n// 2. Команда на выбор студента (/info)\nelse if (text === \"/info\") {\n    replyText = \"Лабораторная работа по визуальному программированию. Node-RED + Telegram Bot в Docker.\";\n}\n// 3. Эхо на любое другое сообщение\nelse {\n    replyText = `Эхо : ${text}`;\n}\n\n// Формируем сообщение для отправки обратно\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: replyText\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
