        "z": "f6f2187d.f17ca8",
        "name": "function 6",
        "func": "// 1. Считываем значение счетчика из контекста потока (flow context)\n// Если счетчик еще не создан — берем 0\nlet count = flow.get(\"clickCounter\") || 0;\n\n// 2. Увеличиваем значение на 1 при каждом вызове\ncount += 1;\n\n// 3. Сохраняем обновленное число обратно в память контекста!\nflow.set(\"clickCounter\", count);\n\n// Формируем красивый ответ\nmsg.payload = {\n    developer: \"Гавриловец Илья\",\n    contextScope: \"flow context\",\n    currentCount: count,\n    message: `Кнопка нажата ${count} раз(а). Значение хранится в flow context!`\n};\n\nreturn msg;",
